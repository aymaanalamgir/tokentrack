# Non-sensitive examples ONLY. Replace every password before starting.
POSTGRES_DB=tokentrack_development
POSTGRES_USER=tokentrack_admin
POSTGRES_PASSWORD=replace-with-a-local-admin-password
CORE_DB_USER=tokentrack_core
CORE_DB_PASSWORD=replace-with-a-local-core-password
USAGE_DB_USER=tokentrack_usage
USAGE_DB_PASSWORD=replace-with-a-local-usage-password
# Separate database for Rails tests; initialized with the same schema boundaries.
POSTGRES_TEST_DB=tokentrack_test
FRONTEND_PORT=3000
CORE_API_PORT=3001
USAGE_ENGINE_PORT=8080
POSTGRES_PORT=5432
FRONTEND_ORIGIN=http://localhost:3000
# Server-only URLs. For host-based frontend development use localhost ports instead.
CORE_API_URL=http://core-api:3001
USAGE_ENGINE_URL=http://usage-engine:8080
# Development/test only. Rails always disables demo authentication in production.
DEMO_AUTH_ENABLED=true
